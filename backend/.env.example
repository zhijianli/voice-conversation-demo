OPENAI_API_KEY=sk-your-api-key-here
REALTIME_MODEL=gpt-realtime-2.1

# Langfuse（页面开关开启时拉取提示词）
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_CONSTITUTION_PROMPT_NAME=everecho/constitution/dialogue
LANGFUSE_PROMPT_NAME=everecho/free_coach/default
LANGFUSE_PROMPT_LABEL=staging
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=60

# EverEcho free-coach
# auto：本机开发走线上；部署到 EC2 走本机 http://127.0.0.1:3000/v1
# 可强制 online / local；override 时再设 EVERECHO_API_BASE
EVERECHO_TARGET=auto
EVERECHO_API_BASE_ONLINE=https://api.volohorizon.com/v1
EVERECHO_API_BASE_LOCAL=http://127.0.0.1:3000/v1
EVERECHO_TIME_ZONE=Asia/Shanghai
# 启动时预创建几场 free-coach 会话，点击「开始对话」时直接取用
FREE_COACH_SESSION_POOL_SIZE=3

# Amazon Transcribe Streaming + Polly Generative (English)
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
TRANSCRIBE_LANGUAGE_CODE=en-US
TRANSCRIBE_SAMPLE_RATE=16000
POLLY_VOICE_ID=Ruth
POLLY_ENGINE=generative
POLLY_LANGUAGE_CODE=en-US

# MiniMax TTS (Chinese) — official sync API
MINIMAX_PROVIDER=official
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_VOICE_ID="Chinese (Mandarin)_IntellectualGirl"
MINIMAX_MODEL_ID=speech-2.6-turbo
MINIMAX_EMOTION=calm
MINIMAX_SPEED=0.95

# ElevenLabs TTS (optional fallback) + Conversational AI Agent
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pFZP5JQG7iQjIQuC4Bku
ELEVENLABS_MODEL_ID=eleven_v3_conversational
# Conversational AI Agent（/realtime/elevenlabs 页面）
ELEVENLABS_AGENT_ID=
# true：前端强制走 conversation token（API key 需有 convai_write）；默认 false，用公开 agentId
ELEVENLABS_REQUIRE_SIGNED_URL=
# Custom LLM 适配层密钥，填到 ElevenLabs Agent 的 Custom LLM API key
ELEVENLABS_CUSTOM_LLM_SECRET=
# 给 ElevenLabs Dashboard 填的 Custom LLM Server URL（不含 /v1/chat/completions）
# 生产默认：https://api.volohorizon.com/realtime/api/elevenlabs
ELEVENLABS_CUSTOM_LLM_URL=
ELEVENLABS_CUSTOM_LLM_MODEL=free-coach
